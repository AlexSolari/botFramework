{
    "name": "chz-telegram-bot",
    "description": "Opinionated TypeScript framework that provides a structured approach to building Telegram bots.",
    "author": {
        "name": "Alex Halanin",
        "url": "https://github.com/AlexSolari"
    },
    "license": "MIT",
    "keywords": [
        "telegram",
        "telegram bot"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/AlexSolari/botFramework.git"
    },
    "version": "0.8.3",
    "type": "module",
    "dependencies": {
        "async-sema": "^3.1.1"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/bun": "^1.4.2",
        "@types/node": "^22.20.4",
        "eslint": "^9.39.5",
        "jiti": "^2.7.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.71.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "bun test",
        "lint": "tsc -p tsconfig.build.json --noEmit",
        "generate:types": "bun scripts/generateBotApiTypes.ts",
        "prep": "bun run generate:types && bun run test && bun run build"
    }
}
